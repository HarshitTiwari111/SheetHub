PORT=5100
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5273

# Database Connection (Local or MongoDB Atlas with TLS/SSL, IP Restrictions & Encryption)
MONGO_URI=mongodb://127.0.0.1:27017/sheethub
# For Atlas Production: mongodb+srv://<user>:<password>@cluster.mongodb.net/sheethub?retryWrites=true&w=majority&tls=true

# JWT Cryptographic secrets — Use openssl rand -hex 64 to generate
JWT_ACCESS_SECRET=dev_access_secret_replace_in_production_use_long_random_string_min_64_chars_abc123
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_use_different_long_random_string_xyz789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security & HTTPS
COOKIE_DOMAIN=
COOKIE_SECURE=false # Set true in production over HTTPS

# Rate limiting & Cloudflare WAF protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=20

# 4-Tier RBAC Super Admin Credentials
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@sheethub.com
SUPER_ADMIN_PASSWORD=admin123
