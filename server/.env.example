PORT=5100
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5273

MONGO_URI=mongodb://127.0.0.1:27017/sheethub

# JWT secrets — CHANGE THESE in production, use openssl rand -hex 64
JWT_ACCESS_SECRET=change_this_to_a_long_random_string_min_64_chars
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie settings
COOKIE_DOMAIN=
# In production set COOKIE_SECURE=true (requires HTTPS)
COOKIE_SECURE=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# Super Admin seed (run: npm run seed)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@sheethub.com
SUPER_ADMIN_PASSWORD=admin123
